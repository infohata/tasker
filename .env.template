# Real .env is gitignored. Copy this file to .env and replace test values.
#
# IMPORTANT — Docker Compose interpolates $-references inside .env values.
# If a generated value contains a literal `$`, escape it as `$$`, or
# regenerate the value using a $-free character set. Otherwise compose
# silently corrupts the value.

# Django
DJANGO_SECRET_KEY=change-me-to-a-real-secret
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,nginx,web

# Database — single source of truth. compose.yml interpolates DATABASE_URL
# from these for the web container; do NOT add a separate DATABASE_URL here.
POSTGRES_DB=tasker
POSTGRES_USER=tasker
POSTGRES_PASSWORD=change-me-too

# Cache / Channels layer — rediscache:// scheme maps to django_redis.cache.RedisCache via django-environ
REDIS_URL=rediscache://redis:6379/1?client_class=django_redis.client.DefaultClient
